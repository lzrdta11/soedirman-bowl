{
  "name": "soedirman-bowl",
  "version": "1.0.0",
  "description": "Soedirman Bowl - Online Server-Sided Flag Football App on Cloudflare Workers & D1",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create soedirman-bowl-db",
    "d1:init:local": "wrangler d1 execute soedirman-bowl-db --local --file=./schema.sql",
    "d1:init:remote": "wrangler d1 execute soedirman-bowl-db --remote --file=./schema.sql"
  },
  "keywords": [
    "flag-football",
    "soedirman-bowl",
    "cloudflare-workers",
    "cloudflare-d1"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.155.0"
  }
}
